{
  "name": "erp-avanzi",
  "version": "1.1.1",
  "description": "",
  "main": "main.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "electron": "electron .",
    "build": "electron-builder"
  },
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.18.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.2.2"
  },
  "build": {
    "appId": "com.avanzi.erp",
    "productName": "Super Avanzi ERP",
    "win": {
      "target": "nsis"
    },
    "files": [
      "**/*",
      "!node_modules/.cache",
      "!**/*.md",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      },
      {
        "from": "src/importar_produtos_xlsx.py",
        "to": "importar_produtos_xlsx.py"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}