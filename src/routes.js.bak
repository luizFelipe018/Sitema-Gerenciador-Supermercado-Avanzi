        const db = require('./config/database')
        const { q, categoria } = req.query
        let query  = 'SELECT * FROM textos WHERE 1=1'
        const params = []
        if (q) {
            query += ' AND (titulo LIKE ? OR conteudo LIKE ? OR tags LIKE ?)'
