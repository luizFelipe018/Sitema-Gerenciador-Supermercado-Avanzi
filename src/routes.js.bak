// ── Imagem de prato para cardápio ────────────────────
router.get('/prato-imagem', authMiddleware, async (req, res) => {
    const nome = req.query.nome
    if (!nome) return res.status(400).json({ error: 'Nome obrigatório' })

    // Lê do banco se disponível, senão usa .env
    let PASTA_PRATOS = process.env.PASTA_PRATOS || 'E:\\Imagens\\Pratos'
    try {
        const db = require('./config/database')
        const [rows] = await db.query("SELECT valor FROM configuracoes WHERE chave = 'pasta_pratos'")
        if (rows[0]) PASTA_PRATOS = rows[0].valor
    } catch {}

    console.log('[PRATO] Buscando:', nome, '| Pasta:', PASTA_PRATOS, '| Existe:', fs.existsSync(PASTA_PRATOS))

    const exts = ['.png', '.jpg', '.jpeg', '.PNG', '.JPG', '.JPEG']
    for (const ext of exts) {
        const caminho = path.join(PASTA_PRATOS, nome + ext)
        if (fs.existsSync(caminho)) return res.sendFile(caminho)
    }

    // Busca parcial — procura arquivo que contenha o nome
    try {
        const arquivos = fs.readdirSync(PASTA_PRATOS)
        const nomeUp   = nome.toUpperCase().replace(/[^A-Z0-9 ]/g, '')
        const encontrado = arquivos.find(a => {
            const semExt = a.replace(/\.[^.]+$/, '').toUpperCase().replace(/[^A-Z0-9 ]/g, '')
            return semExt.includes(nomeUp) || nomeUp.includes(semExt)
        })
        if (encontrado) {
            console.log('[PRATO] Encontrado parcial:', encontrado)
            return res.sendFile(path.join(PASTA_PRATOS, encontrado))
        }
        console.log('[PRATO] Arquivos na pasta:', arquivos.slice(0,5))
    } catch (err) {
        console.log('[PRATO] Erro ao ler pasta:', err.message)
    }

    res.status(404).json({ error: 'Imagem não encontrada', nome, pasta: PASTA_PRATOS })
})

// ── Exportar Lista como XLSX (usando ExcelJS via Node) ──
router.get('/listas/:id/exportar-xlsx', authMiddleware, async (req, res) => {
    const db = require('./config/database')
    try {
        const [[lista]] = await db.query('SELECT * FROM listas_precos WHERE id = ?', [req.params.id])
        if (!lista) return res.status(404).json({ error: 'Lista não encontrada' })

        const [itens] = await db.query(
            'SELECT * FROM listas_precos_itens WHERE lista_id = ? ORDER BY ordem ASC, id ASC',
            [req.params.id]
        )

        const ExcelJS = require('exceljs')
        const wb = new ExcelJS.Workbook()
        const ws = wb.addWorksheet('Planilha1')

        // Colunas
        ws.columns = [
            { key: 'codigo',    width: 14 },
            { key: 'descricao', width: 45 },
            { key: 'ean',       width: 18 },
            { key: 'preco',     width: 12 },
        ]

        // Cabeçalho
        const header = ws.addRow(['CODIGO', 'DESCRICAO', 'EAN', 'PRECO'])
        header.height = 20
        header.eachCell(cell => {
            cell.font      = { name: 'Calibri', size: 11, bold: true, color: { argb: 'FFFFFFFF' } }
            cell.fill      = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFB51515' } }
            cell.alignment = { horizontal: 'center', vertical: 'middle' }
            cell.border    = { top:{style:'thin',color:{argb:'FFE5E7EB'}}, bottom:{style:'thin',color:{argb:'FFE5E7EB'}}, left:{style:'thin',color:{argb:'FFE5E7EB'}}, right:{style:'thin',color:{argb:'FFE5E7EB'}} }
        })

        // Busca lista pai para diff
        let itensPai = []
        if (lista.lista_pai_id) {
            const [rowsPai] = await db.query(
                'SELECT * FROM listas_precos_itens WHERE lista_id = ? ORDER BY ordem ASC, id ASC',
                [lista.lista_pai_id]
            )
            itensPai = rowsPai
        }

        const descsPai   = new Set(itensPai.map(i => i.descricao.toUpperCase()))
        const descsFilho = new Set(itens.map(i => i.descricao.toUpperCase()))
        const temDiff    = itensPai.length > 0

        const adicionados = temDiff ? itens.filter(i => !descsPai.has(i.descricao.toUpperCase()))   : []
        const removidos   = temDiff ? itensPai.filter(i => !descsFilho.has(i.descricao.toUpperCase())) : []
        const mantidos    = temDiff ? itens.filter(i => descsPai.has(i.descricao.toUpperCase()))    : itens

        const borda = { top:{style:'thin',color:{argb:'FFE5E7EB'}}, bottom:{style:'thin',color:{argb:'FFE5E7EB'}}, left:{style:'thin',color:{argb:'FFE5E7EB'}}, right:{style:'thin',color:{argb:'FFE5E7EB'}} }

        const addRow = (item, tipo, idx) => {
            const preco = parseFloat(item.preco || 0).toFixed(2).replace('.', ',')
            const row   = ws.addRow([item.codigo || '', item.descricao || '', item.ean || '', preco])

            let fill, fontColor, prefix = ''
            if (tipo === 'adicionado') {
                fill      = { type:'pattern', pattern:'solid', fgColor:{ argb:'FFD1FAE5' } } // verde claro
                fontColor = 'FF166534'
                prefix    = '+ '
            } else if (tipo === 'removido') {
                fill      = { type:'pattern', pattern:'solid', fgColor:{ argb:'FFFEE2E2' } } // vermelho claro
                fontColor = 'FF991B1B'
                prefix    = '- '
            } else {
                fill = idx % 2 === 0
                    ? { type:'pattern', pattern:'solid', fgColor:{ argb:'FFF9F9F9' } }
                    : { type:'pattern', pattern:'solid', fgColor:{ argb:'FFFFFFFF' } }
                fontColor = 'FF111827'
            }

            row.eachCell((cell, col) => {
                cell.font      = { name:'Calibri', size:11, color:{ argb: fontColor }, strike: tipo === 'removido' }
                cell.fill      = fill
                cell.border    = borda
                cell.alignment = col === 2 ? { horizontal:'left',   vertical:'middle' }
                               : col === 4 ? { horizontal:'right',  vertical:'middle' }
                               :             { horizontal:'center', vertical:'middle' }
                if (col === 3) cell.numFmt = '@'
                // Prefixo na descrição
                if (col === 2 && prefix) cell.value = prefix + cell.value
            })
        }

        // Ordem igual à tela: adicionados ▸ mantidos ▸ removidos
        if (temDiff && (adicionados.length || removidos.length)) {
            adicionados.forEach((item, i) => addRow(item, 'adicionado', i))
            mantidos.forEach((item, i)    => addRow(item, 'mantido', i))
            removidos.forEach((item, i)   => addRow(item, 'removido', i))

            // Linha separadora + legenda
            ws.addRow([])
            const legenda = ws.addRow([`Alterações: +${adicionados.length} adicionado(s)   −${removidos.length} removido(s)   =${mantidos.length} mantido(s)`])
            ws.mergeCells(`A${legenda.number}:D${legenda.number}`)
            legenda.getCell(1).font      = { name:'Calibri', size:10, bold:true, color:{ argb:'FF374151' } }
            legenda.getCell(1).alignment = { horizontal:'left' }
        } else {
            // Sem diff — lista normal com linhas alternadas
            itens.forEach((item, i) => addRow(item, 'mantido', i))
        }

        // Rodapé
        ws.addRow([])
        const agora = new Date().toLocaleString('pt-BR')
        const rodape = ws.addRow([`Gerado em: ${agora}`])
        ws.mergeCells(`A${rodape.number}:D${rodape.number}`)
        rodape.getCell(1).font      = { name: 'Calibri', size: 10, italic: true, color: { argb: 'FF666666' } }
        rodape.getCell(1).alignment = { horizontal: 'left' }

        // Envia
        const nomeLimpo = lista.nome.replace(/[^a-zA-Z0-9À-ÿ ]/g, '').trim()
        res.setHeader('Content-Type', 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet')
        res.setHeader('Content-Disposition', `attachment; filename="${nomeLimpo}.xlsx"`)
        await wb.xlsx.write(res)
        res.end()

    } catch (err) {
        console.error('[XLSX] Erro:', err.message)
        res.status(500).json({ error: err.message })
    }
})

