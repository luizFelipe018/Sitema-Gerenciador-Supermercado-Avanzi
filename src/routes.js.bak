const router = require('express').Router()
const path   = require('path')
const fs     = require('fs')

const productController = require('./controllers/productController')
const authController    = require('./controllers/authController')
const userController    = require('./controllers/userController')
const authMiddleware    = require('./middlewares/authMiddleware')

// ── Pasta raiz das imagens (lida do banco em cada requisição) ────
async function getPastaImagens() {
    try {
        const db = require('./config/database')
        const [rows] = await db.query("SELECT valor FROM configuracoes WHERE chave = 'pasta_imagens'")
        if (rows[0]) return rows[0].valor
    } catch {}
    return process.env.PASTA_IMAGENS || 'E:\\Banco de Imagens'
}

// Busca recursiva em todas as subpastas
function buscarImagem(pasta, nomeArquivo) {
    try {
        const itens = fs.readdirSync(pasta)
        for (const item of itens) {
            const caminhoCompleto = path.join(pasta, item)
            const stat = fs.statSync(caminhoCompleto)
            if (stat.isDirectory()) {
                const encontrado = buscarImagem(caminhoCompleto, nomeArquivo)
                if (encontrado) return encontrado
            } else {
                // Compara sem case e sem espaços extras
                if (item.toLowerCase() === nomeArquivo.toLowerCase()) {
                    return caminhoCompleto
                }
            }
        }
    } catch { /* pasta não acessível */ }
    return null
}

// GET /imagem?nome=FRUTA AMEIXA
// GET /imagem?codigo=1000
router.get('/imagem', async (req, res) => {
    console.log('[IMAGEM] Query:', req.query)
    try {
        let nomeArquivo = null

        if (req.query.nome) {
            // Busca direto pelo nome
            nomeArquivo = req.query.nome.trim().toUpperCase() + '.png'
        } else if (req.query.codigo) {
            // Busca o produto no banco para pegar a descrição
            const db = require('./config/database')
            const [rows] = await db.query('SELECT descricao FROM produtos WHERE codigo = ?', [req.query.codigo])
            if (!rows[0]) return res.status(404).json({ error: 'Produto não encontrado' })
            nomeArquivo = rows[0].descricao.trim().toUpperCase() + '.png'
        } else {
            return res.status(400).json({ error: 'Informe nome ou codigo' })
        }

        const PASTA_IMAGENS = await getPastaImagens()
        console.log('[IMAGEM] Buscando arquivo:', nomeArquivo)
        console.log('[IMAGEM] Pasta:', PASTA_IMAGENS)
        console.log('[IMAGEM] Pasta existe:', fs.existsSync(PASTA_IMAGENS))
        const caminho = buscarImagem(PASTA_IMAGENS, nomeArquivo)
        console.log('[IMAGEM] Caminho encontrado:', caminho)

        if (!caminho) {
            // Fallback: buscar no Open Food Facts
            console.log('[IMAGEM] Não encontrada localmente, buscando no Open Food Facts...')
            try {
                const nomeBusca = req.query.nome || req.query.codigo
                const produtoOFF = await buscarOpenFoodFacts(nomeBusca)
                if (produtoOFF && produtoOFF.image_url) {
                    console.log('[IMAGEM] Encontrada no OFF, usando proxy:', produtoOFF.image_url)
                    const proxyUrl = `http://localhost:3000/off-image?url=${encodeURIComponent(produtoOFF.image_url)}`
                    return res.redirect(proxyUrl)
                }
            } catch (e) {
                console.log('[IMAGEM] Erro no OFF:', e.message)
            }
            return res.status(404).json({ error: 'Imagem não encontrada', nome: nomeArquivo })
        }

        res.sendFile(caminho)

    } catch (err) {
        console.error('Erro ao buscar imagem:', err)
        res.status(500).json({ error: err.message })
    }
})

// Função para buscar no Open Food Facts
async function buscarOpenFoodFacts(termo) {
    const https = require('https')
    console.log('[OFF] Iniciando busca por:', termo)
    
    return new Promise((resolve, reject) => {
        const isCodigo = /^\d+$/.test(String(termo))
        let url = ''
        
        if (isCodigo && String(termo).length >= 8) {
            url = `https://world.openfoodfacts.org/api/v0/product/${termo}.json`
            console.log('[OFF] URL (codigo):', url)
        } else {
            url = `https://world.openfoodfacts.org/cgi/search.pl?search_terms=${encodeURIComponent(termo)}&search_simple=1&action=process&json=1&page_size=1`
            console.log('[OFF] URL (nome):', url)
        }
        
        https.get(url, (res) => {
            let data = ''
            res.on('data', chunk => data += chunk)
            res.on('end', () => {
                try {
                    const json = JSON.parse(data)
                    if (isCodigo) {
                        if (json.status === 1 && json.product) {
                            const p = json.product
                            resolve({
                                image_url: p.image_front_url || p.image_url || p.image_small_url,
                                image_small_url: p.image_front_small_url || p.image_small_url,
                                product_name: p.product_name || p.product_name_pt,
                                brands: p.brands,
                                categories: p.categories
                            })
                        } else {
                            resolve(null)
                        }
                    } else {
                        if (json.products && json.products.length > 0) {
                            const p = json.products[0]
                            resolve({
                                image_url: p.image_front_url || p.image_front_small_url || p.image_small_url || p.image_url,
                                image_small_url: p.image_front_small_url || p.image_small_url,
                                product_name: p.product_name || p.product_name_pt,
                                brands: p.brands,
                                categories: p.categories
                            })
                        } else {
                            resolve(null)
                        }
                    }
                } catch (e) {
                    reject(e)
                }
            })
        }).on('error', reject)
    })
}

// Proxy de imagem do Open Food Facts (evita CSP do Electron)
router.get('/off-image', (req, res) => {
    const { url } = req.query
    if (!url) return res.status(400).json({ error: 'URL obrigatória' })
    
    try {
        const https = require('https')
        https.get(url, (imgRes) => {
            if (imgRes.statusCode !== 200) {
                return res.status(404).json({ error: 'Imagem não encontrada' })
            }
            res.setHeader('Content-Type', imgRes.headers['content-type'] || 'image/jpeg')
            res.setHeader('Cache-Control', 'public, max-age=86400')
            imgRes.pipe(res)
        }).on('error', (e) => {
            res.status(500).json({ error: e.message })
        })
    } catch (err) {
        res.status(500).json({ error: err.message })
    }
})

// ── Open Food Facts - API pública ─────────────────────────
router.get('/off-buscar', async (req, res) => {
    try {
        const { q, ean, codigo } = req.query
        if (!q && !ean && !codigo) {
            return res.status(400).json({ error: 'Informe q, ean ou codigo' })
        }
        
        const termo = q || ean || codigo
        const resultado = await buscarOpenFoodFacts(termo)
        
        if (resultado) {
            res.json(resultado)
        } else {
            res.status(404).json({ error: 'Produto não encontrado no Open Food Facts' })
        }
    } catch (err) {
        res.status(500).json({ error: err.message })
    }
})

// ── Rotas de configuração ────────────────────────────
router.get('/configuracao/:chave', authMiddleware, async (req, res) => {
    try {
        const db = require('./config/database')
        const [rows] = await db.query('SELECT valor FROM configuracoes WHERE chave = ?', [req.params.chave])
        if (!rows[0]) return res.status(404).json({ error: 'Configuração não encontrada' })
        res.json({ chave: req.params.chave, valor: rows[0].valor })
    } catch (err) {
        res.status(500).json({ error: err.message })
    }
})

router.put('/configuracao/:chave', authMiddleware, async (req, res) => {
    try {
        const db = require('./config/database')
        const { valor } = req.body
        if (!valor) return res.status(400).json({ error: 'Valor obrigatório' })
        await db.query(
            'INSERT INTO configuracoes (chave, valor) VALUES (?, ?) ON DUPLICATE KEY UPDATE valor = ?',
            [req.params.chave, valor, valor]
        )
        res.json({ chave: req.params.chave, valor })
    } catch (err) {
        res.status(500).json({ error: err.message })
    }
})

